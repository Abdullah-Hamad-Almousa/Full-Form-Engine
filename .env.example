# Application
APP_NAME=Field Data Application
APP_PORT=8080
NODE_ENV=production
TZ=Asia/Riyadh

# PostgreSQL
POSTGRES_DB=field_app
POSTGRES_USER=field_app_user
POSTGRES_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD
DATABASE_URL=postgresql://field_app_user:CHANGE_THIS_DATABASE_PASSWORD@database:5432/field_app?schema=public

# Authentication
SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
SESSION_COOKIE_NAME=field_app_session
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=strict
