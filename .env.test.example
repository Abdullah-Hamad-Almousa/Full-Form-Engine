# Dedicated local test database; never point these values at development or production data
TEST_POSTGRES_DB=field_app_test
# Used by tests run from the host while the dev database is bound to localhost
TEST_DATABASE_URL=postgresql://field_app_user:CHANGE_THIS_DATABASE_PASSWORD@127.0.0.1:5432/field_app_test?schema=public
# Used by the profile-gated tools container on the Compose network
DATABASE_URL=postgresql://field_app_user:CHANGE_THIS_DATABASE_PASSWORD@database:5432/field_app_test?schema=public
